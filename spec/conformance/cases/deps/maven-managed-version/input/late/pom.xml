<?xml version="1.0" encoding="UTF-8"?>
<!-- The unversioned declaration comes first and the managed one after it: the declaration
     with a version still wins (the order does not matter between the two kinds). -->
<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.acme</groupId>
  <artifactId>late</artifactId>
  <version>2.0.0</version>
  <dependencies>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
    </dependency>
  </dependencies>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcpkix-jdk18on</artifactId>
        <version>1.78</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
