<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ch.unibe.seg</groupId>
  <artifactId>ciphersift</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>CipherSift</name>
  <description>Static scanner for cryptographic assets in Java and Python sources and dependency manifests; writes CycloneDX 1.7 (or 1.6) CBOMs.</description>
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>23</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>

    <jtreesitter.version>0.26.1</jtreesitter.version>
    <jackson.version>2.22.3</jackson.version>
    <picocli.version>4.7.7</picocli.version>
    <networknt.version>2.0.4</networknt.version>
    <junit.version>6.1.3</junit.version>
    <cyclonedx.version>13.2.0</cyclonedx.version>
    <slf4j.version>2.0.17</slf4j.version>

    <native.platform>linux-x86_64</native.platform>
    <surefire.native.args>--enable-native-access=ALL-UNNAMED</surefire.native.args>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.tree-sitter</groupId>
      <artifactId>jtreesitter</artifactId>
      <version>${jtreesitter.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-toml</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
      <version>${picocli.version}</version>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${networknt.version}</version>
    </dependency>
    <dependency>
      <!-- logging API of json-schema-validator; CipherSift registers a silent provider -->
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.cyclonedx</groupId>
      <artifactId>cyclonedx-core-java</artifactId>
      <version>${cyclonedx.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>src/main/resources-filtered</directory>
        <filtering>true</filtering>
      </resource>
      <!-- the repository's rules/ is the bundled rule set (SPEC 5.1, 15.2) -->
      <resource>
        <directory>${project.basedir}/rules</directory>
        <targetPath>rules</targetPath>
      </resource>
      <resource>
        <directory>${project.basedir}/spec</directory>
        <targetPath>schema</targetPath>
        <includes>
          <include>rule-schema.json</include>
        </includes>
      </resource>
      <!-- licence texts that must travel with the fat jar (MIT requires the notice in all copies) -->
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF/ciphersift</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
        </includes>
      </resource>
      <resource>
        <directory>${project.basedir}/native/vendor</directory>
        <targetPath>META-INF/ciphersift/licenses</targetPath>
        <includes>
          <include>*/LICENSE</include>
          <include>tree-sitter/lib/src/unicode/LICENSE</include>
        </includes>
      </resource>
      <!-- native libraries built by native/build-natives.sh (SPEC 15.3) -->
      <resource>
        <directory>${project.build.directory}/native</directory>
        <targetPath>native</targetPath>
      </resource>
    </resources>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.4.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.3</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.5.3</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>com.mycila</groupId>
          <artifactId>license-maven-plugin</artifactId>
          <version>4.6</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <!-- builds the native libraries only when they are missing from target/native/ -->
            <id>build-natives</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bash</executable>
              <arguments>
                <argument>${project.basedir}/native/build-natives.sh</argument>
                <argument>ensure</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <!-- validates the bundled rules in full and records their key; fails the build on any problem.
                 At run time the schema validation of the bundled rules is skipped only for this exact set. -->
            <id>validate-bundled-rules</id>
            <phase>process-classes</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <arguments>
                <argument>-classpath</argument>
                <classpath/>
                <argument>ch.unibe.seg.ciphersift.rules.BundledRulesCheck</argument>
                <argument>${project.build.outputDirectory}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${maven.compiler.release}</release>
          <compilerArgs>
            <arg>-Xlint:all,-processing,-serial</arg>
          </compilerArgs>
        </configuration>
        <executions>
          <execution>
            <id>default-compile</id>
            <configuration>
              <excludes>
                <exclude>ch/unibe/seg/ciphersift/Main.java</exclude>
              </excludes>
            </configuration>
          </execution>
          <execution>
            <!-- the jar's entry point is compiled for Java 8, so that an old runtime gets a clear
                 "needs Java 23" message instead of UnsupportedClassVersionError -->
            <id>compile-entry-point</id>
            <phase>compile</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <release>8</release>
              <includes>
                <include>ch/unibe/seg/ciphersift/Main.java</include>
              </includes>
              <compilerArgs>
                <arg>-Xlint:all,-processing,-serial,-options</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>${surefire.native.args} -Djava.io.tmpdir=${java.io.tmpdir}</argLine>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>ch.unibe.seg.ciphersift.Main</mainClass>
            </manifest>
            <manifestEntries>
              <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
              <Implementation-Version>${project.version}</Implementation-Version>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>all</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                  <addHeader>false</addHeader>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>ch.unibe.seg.ciphersift.Main</mainClass>
                  <manifestEntries>
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                    <Implementation-Version>${project.version}</Implementation-Version>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <!-- conformance, schema and determinism tests run against the fat jar -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>${surefire.native.args} -Djava.io.tmpdir=${java.io.tmpdir}</argLine>
          <trimStackTrace>false</trimStackTrace>
          <systemPropertyVariables>
            <ciphersift.jar>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</ciphersift.jar>
            <ciphersift.basedir>${project.basedir}</ciphersift.basedir>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>com.mycila</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <configuration>
          <strictCheck>false</strictCheck>
          <failIfMissing>true</failIfMissing>
          <aggregate>false</aggregate>
          <licenseSets>
            <licenseSet>
              <inlineHeader>SPDX-License-Identifier: Apache-2.0
Copyright 2026 The CipherSift Authors</inlineHeader>
              <includes>
                <include>pom.xml</include>
                <include>Dockerfile</include>
                <include>bin/**</include>
                <include>native/*.sh</include>
                <include>native/sources.lock</include>
                <include>src/**/*.java</include>
                <include>src/test/resources/**/*.yaml</include>
                <include>rules/**/*.yaml</include>
                <include>spec/tools/*.py</include>
                <include>spec/tools/*.java</include>
                <include>spec/tools/*.yaml</include>
              </includes>
              <excludes>
                <!-- test data (line numbers must not shift), vendored MIT sources, build output -->
                <exclude>spec/conformance/cases/**</exclude>
                <exclude>native/vendor/**</exclude>
                <exclude>target/**</exclude>
                <exclude>.m2/**</exclude>
                <exclude>**/*.json</exclude>
              </excludes>
            </licenseSet>
          </licenseSets>
          <mapping>
            <lock>SCRIPT_STYLE</lock>
            <Dockerfile>SCRIPT_STYLE</Dockerfile>
            <ciphersift>SCRIPT_STYLE</ciphersift>
            <java>SLASHSTAR_STYLE</java>
            <RegexParity.java>DOUBLESLASH_STYLE</RegexParity.java>
          </mapping>
        </configuration>
        <executions>
          <execution>
            <id>check-headers</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
